{
  "name": "licerepo",
  "version": "1.0.4",
  "description": "Generates a license report for a package to ensure EU legal compliance.",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development npx mix",
    "watch": "cross-env NODE_ENV=development npx mix watch",
    "build": "cross-env NODE_ENV=production npx mix --production",
    "prod": "cross-env NODE_ENV=production npx mix --production"
  },
  "keywords": [],
  "author": "J. Toshio Taniguchi",
  "license": "LicenseRef-Edu-Taniguchi-2026",
  "licenses": [
    {
      "type": "GPL-3.0-or-later",
      "url": "./LICENSE-GPL.md"
    },
    {
      "type": "LicenseRef-Commercial-Taniguchi-2026",
      "url": "./LICENSE-COMMERCIAL.md"
    }
  ],
  "type": "commonjs",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "laravel-mix": "^6.0.49",
    "webpack-obfuscator": "^3.5.1"
  }
}